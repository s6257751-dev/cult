local function IYUAPKJ_fake_script() -- TextButton5.LocalScript 
	local script = Instance.new('LocalScript', TextButton5)

	-- LocalScript (например внутрь TextButton 5)
	
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	local button = script.Parent
	
	-- ===== НАСТРОЙКИ =====
	local TOOL_NAME = " "
	local ANIMATION_ID = "rbxassetid://PUT_YOUR_ANIMATION_ID_HERE"
	
	local PART_SIZE = Vector3.new(0.001, 7.222, 9.443)
	local PART_COLOR = Color3.fromRGB(255, 108, 5)
	local PART_TRANSPARENCY = 0.7
	local FORWARD_OFFSET = 2.5
	
	local ROTATE_Y_DEG = 90 -- поворот на 90°
	
	-- ===== СТЕЙТС =====
	local active = false
	local orangePart = nil
	local heartbeatConn = nil
	
	local overrideTrack = nil
	local currentHumanoid = nil
	local hpChangedConn = nil
	
	-- ===== Утилиты =====
	local function getHumanoid()
		local char = player.Character
		if not char then return nil end
		return char:FindFirstChildOfClass("Humanoid")
	end
	
	local function getAnimator(humanoid)
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end
		return animator
	end
	
	local function findToolAnywhere()
		-- ищем tool и в руке (Character), и в Backpack
		local char = player.Character
		if char then
			local t = char:FindFirstChild(TOOL_NAME)
			if t then return t end
		end
	
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			local t = backpack:FindFirstChild(TOOL_NAME)
			if t then return t end
		end
	
		return nil
	end
	
	local function isToolEquipped()
		local char = player.Character
		if not char then return false end
		return char:FindFirstChild(TOOL_NAME) ~= nil
	end
	
	-- ===== TOOL (ТОЛЬКО по клику, но корректно после рестартов) =====
	local function ensureToolExistsAfterClick()
		-- если tool уже есть (в руке или в backpack) — просто выходим
		local existing = findToolAnywhere()
		if existing then
			return
		end
	
		-- иначе создаём и кладём в Backpack
		local backpack = player:WaitForChild("Backpack")
		local tool = Instance.new("Tool")
		tool.Name = TOOL_NAME
		tool.RequiresHandle = false
		tool.CanBeDropped = false
	
		tool.Parent = backpack
	end
	
	-- ===== Part =====
	local function createOrangePart()
		if orangePart then return end
	
		local part = Instance.new("Part")
		part.Name = "OrangeVisual"
		part.Size = PART_SIZE
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Material = Enum.Material.Neon
		part.Color = PART_COLOR
		part.Transparency = PART_TRANSPARENCY
		part.Parent = workspace
	
		orangePart = part
	end
	
	local function updateOrangePartPosition()
		local char = player.Character
		if not char then return end
	
		local humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
		if not humanoidRootPart then return end
	
		local look = humanoidRootPart.CFrame.LookVector
		local pos = humanoidRootPart.Position + look * FORWARD_OFFSET
	
		local base = CFrame.new(pos, pos + look)
		local rotate = CFrame.Angles(0, math.rad(ROTATE_Y_DEG), 0)
	
		if orangePart then
			orangePart.CFrame = base * rotate
		end
	end
	
	local function startPartFollow()
		if heartbeatConn then return end
		createOrangePart()
	
		heartbeatConn = game:GetService("RunService").Heartbeat:Connect(function()
			if not active then return end
			if orangePart and orangePart.Parent then
				updateOrangePartPosition()
			end
		end)
	end
	
	local function stopPartCleanup()
		active = false
	
		if heartbeatConn then
			heartbeatConn:Disconnect()
			heartbeatConn = nil
		end
	
		if orangePart then
			orangePart:Destroy()
			orangePart = nil
		end
	end
	
	-- ===== HP антиурон (чтобы можно было снова умирать) =====
	local function startInfiniteHP(humanoid)
		-- на всякий отключим старый коннект
		if hpChangedConn then
			hpChangedConn:Disconnect()
			hpChangedConn = nil
		end
	
		-- сразу выровняем
		humanoid.Health = humanoid.MaxHealth
	
		hpChangedConn = humanoid.HealthChanged:Connect(function(newHealth)
			-- Если актив не включен — не трогаем HP
			if not active then return end
	
			-- Если получен урон — моментально возвращаем MaxHealth
			if newHealth < humanoid.MaxHealth then
				humanoid.Health = humanoid.MaxHealth
			end
		end)
	end
	
	local function stopInfiniteHP()
		if hpChangedConn then
			hpChangedConn:Disconnect()
			hpChangedConn = nil
		end
	end
	
	-- ===== Анимация инструмента (не ломает ходьбу/прыжок) =====
	local function playOverrideAnimation(humanoid)
		if not ANIMATION_ID or ANIMATION_ID == "rbxassetid://PUT_YOUR_ANIMATION_ID_HERE" then
			return
		end
	
		local animator = getAnimator(humanoid)
	
		-- если уже проигрывается — остановим и перезагрузим
		if overrideTrack then
			pcall(function() overrideTrack:Stop(0.1) end)
			overrideTrack = nil
		end
	
		local anim = Instance.new("Animation")
		anim.AnimationId = ANIMATION_ID
	
		overrideTrack = animator:LoadAnimation(anim)
		overrideTrack.Priority = Enum.AnimationPriority.Action
		overrideTrack:Play(0.1)
	end
	
	local function stopOverrideAnimation()
		if overrideTrack then
			pcall(function()
				overrideTrack:Stop(0.1)
			end)
			overrideTrack = nil
		end
	end
	
	-- ===== Start/Stop =====
	local function activateForCurrentHumanoid()
		local humanoid = getHumanoid()
		if not humanoid then return end
		currentHumanoid = humanoid
	
		active = true
	
		-- Part
		createOrangePart()
		startPartFollow()
	
		-- HP
		startInfiniteHP(humanoid)
	
		-- Animation
		playOverrideAnimation(humanoid)
	end
	
	local function deactivate()
		active = false
		stopInfiniteHP()
		stopOverrideAnimation()
		stopPartCleanup()
	end
	
	-- ===== Отслеживание экипирования =====
	task.spawn(function()
		local prevEquipped = false
	
		while true do
			task.wait(0.1)
	
			local humanoid = getHumanoid()
			if not humanoid then
				if prevEquipped then
					prevEquipped = false
					deactivate()
				end
				continue
			end
	
			local equipped = isToolEquipped()
	
			if equipped and not prevEquipped then
				prevEquipped = true
				activateForCurrentHumanoid()
			elseif not equipped and prevEquipped then
				prevEquipped = false
				deactivate()
			end
		end
	end)
	
	-- Если будет respawn — выключим старое (на случай)
	player.CharacterAdded:Connect(function()
		deactivate()
	end)
	
	-- ===== Клик по TextButton 5: выдаём tool только по клику =====
	button.MouseButton1Click:Connect(function()
		ensureToolExistsAfterClick()
	end)
end
