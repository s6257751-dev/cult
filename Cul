local function SCFLVXX_fake_script() -- TextButton3.LocalScript 
	local script = Instance.new('LocalScript', TextButton3)

	local button = script.Parent -- кнопка
	local player = game.Players.LocalPlayer
	local character = nil
	local humanoid = nil
	local rootPart = nil
	local runService = game:GetService("RunService")
	local userInput = game:GetService("UserInputService")
	
	local flyEnabled = false
	local bodyVelocity = nil
	local moveDirection = Vector3.new()
	local normalGravity = 196.2
	local flySpeed = 50
	local flySpeedFast = 100
	
	local function setupCharacter()
		character = player.Character or player.CharacterAdded:Wait()
		humanoid = character:FindFirstChildOfClass("Humanoid")
		rootPart = character:FindFirstChild("HumanoidRootPart")
	end
	
	player.CharacterAdded:Connect(setupCharacter)
	if player.Character then setupCharacter() end
	
	local function resetCharacterOrientation()
		if not rootPart then return end
		-- ставим позицию, и отсоединяем наклон
		local pos = rootPart.Position
		rootPart.CFrame = CFrame.new(pos)
		-- обязательно разрешаем вращение, чтобы камера могла управлять обзором
		if humanoid then
			humanoid.AutoRotate = true
		end
	end
	
	local function toggleFly()
		if not character or not humanoid or not rootPart then return end
	
		if not flyEnabled then
			-- Включение полёта
			workspace.Gravity = 0
			humanoid.PlatformStand = true
			-- создаем BodyVelocity для управления движением
			bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.Velocity = Vector3.new()
			bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
			bodyVelocity.Parent = rootPart
			flyEnabled = true
			print("Летание активно")
			-- разрешить свободное вращение камеры
			humanoid.AutoRotate = true
		else
			-- Выключение полёта
			workspace.Gravity = normalGravity
			humanoid.PlatformStand = false
			if bodyVelocity then
				bodyVelocity:Destroy()
				bodyVelocity = nil
			end
			flyEnabled = false
			-- после отключения сбрасываем позу и даем контроль камере
			spawn(function()
				resetCharacterOrientation()
				wait(0.1) -- очень короткая задержка
				-- Важная часть: разрешить камера крутиться
				if humanoid then
					humanoid.AutoRotate = true
				end
			end)
			print("Летание отключено")
		end
	end
	
	-- Обновляем движение через клавиши
	userInput.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.W then
			moveDirection = moveDirection + Vector3.new(0,0,-1)
		elseif input.KeyCode == Enum.KeyCode.S then
			moveDirection = moveDirection + Vector3.new(0,0,1)
		elseif input.KeyCode == Enum.KeyCode.A then
			moveDirection = moveDirection + Vector3.new(-1,0,0)
		elseif input.KeyCode == Enum.KeyCode.D then
			moveDirection = moveDirection + Vector3.new(1,0,0)
		end
	end)
	
	userInput.InputEnded:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.W then
			moveDirection = moveDirection - Vector3.new(0,0,-1)
		elseif input.KeyCode == Enum.KeyCode.S then
			moveDirection = moveDirection - Vector3.new(0,0,1)
		elseif input.KeyCode == Enum.KeyCode.A then
			moveDirection = moveDirection - Vector3.new(-1,0,0)
		elseif input.KeyCode == Enum.KeyCode.D then
			moveDirection = moveDirection - Vector3.new(1,0,0)
		end
	end)
	
	-- Обновление движения во время полёта
	runService.Heartbeat:Connect(function()
		if flyEnabled and bodyVelocity then
			local camera = workspace.CurrentCamera
			local dir = moveDirection
			if dir.Magnitude > 0 then
				local moveVec = (camera.CFrame:VectorToWorldSpace(dir))
				local speed = flySpeed
				if userInput:IsKeyDown(Enum.KeyCode.LeftShift) then
					speed = flySpeedFast
				end
				bodyVelocity.Velocity = moveVec * speed
			else
				bodyVelocity.Velocity = Vector3.new()
			end
		end
	end)
	
	-- ВКЛ/ВЫКЛ летания по кнопке
	button.MouseButton1Click:Connect(toggleFly)
end
