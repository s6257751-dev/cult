local function JYEZMK_fake_script() -- ScreenGui_2.LocalScript 
	local script = Instance.new('LocalScript', ScreenGui_2)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	
	local player = Players.LocalPlayer
	local follower = nil
	local followConnection = nil
	
	local TORSO_COLOR_ID = 23
	local DECAL_ID = "rbxassetid://1649721"
	
	-- ✅ DECAL 50% ПРОЗРАЧНЫЙ
	local function activateDecals()
		local torso = follower:FindFirstChild("Torso")
		if not torso then return end
	
		for _, child in pairs(torso:GetChildren()) do
			if child:IsA("Decal") then child:Destroy() end
		end
	
		local frontDecal = Instance.new("Decal")
		frontDecal.Name = "TShirtFront"
		frontDecal.Texture = DECAL_ID
		frontDecal.Face = Enum.NormalId.Front
		frontDecal.Transparency = 0.5
		frontDecal.Parent = torso
	end
	
	-- ✅ РИГ (СУПЕР БЫСТРЫЙ)
	local function createFollower()
		follower = Instance.new("Model")
		follower.Name = player.Name .. "_SuperFastRig"
		follower.Parent = workspace
	
		local rootPart = Instance.new("Part")
		rootPart.Name = "HumanoidRootPart"
		rootPart.Size = Vector3.new(2, 2, 1)
		rootPart.Transparency = 1
		rootPart.CanCollide = false
		rootPart.Anchored = false
		rootPart.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.5, 0, 1, 1)  -- 0 ГРАВИТАЦИЯ!
		rootPart.Parent = follower
		follower.PrimaryPart = rootPart
	
		local torso = Instance.new("Part")
		torso.Name = "Torso"
		torso.Size = Vector3.new(2.1, 2.1, 1.1)
		torso.Material = Enum.Material.Plastic
		torso.Color = Color3.fromRGB(68, 57, 18)
		torso.Transparency = 0.3
		torso.CanCollide = false
		torso.Anchored = false
		torso.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.5, 0, 1, 1)  -- 0 ГРАВИТАЦИЯ!
		torso.Parent = follower
	
		-- РУКИ + НОГИ (ТЕ ЖЕ)
		local partsData = {
			{name="Left Arm", color="Bright yellow"},
			{name="Right Arm", color="Really black"},
			{name="Left Leg", color="Bright yellow"},
			{name="Right Leg", color="Really black"}
		}
	
		for _, data in pairs(partsData) do
			local part = Instance.new("Part")
			part.Name = data.name
			part.Size = Vector3.new(1, 2, 1)
			part.Material = Enum.Material.Plastic
			part.BrickColor = BrickColor.new(data.color)
			part.Transparency = 0.5
			part.CanCollide = false
			part.Anchored = false
			part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.5, 0, 1, 1)
			part.Parent = follower
		end
	
		-- Motor6D (сокращено)
		local leftArm = follower["Left Arm"]
		local rightArm = follower["Right Arm"]
		local leftLeg = follower["Left Leg"]
		local rightLeg = follower["Right Leg"]
	
		local neck = Instance.new("Motor6D")
		neck.Name = "Neck"; neck.Part0 = rootPart; neck.Part1 = torso
		neck.C0 = CFrame.new(0, 1, 0); neck.Parent = rootPart
	
		local leftShoulder = Instance.new("Motor6D")
		leftShoulder.Name = "Left Shoulder"; leftShoulder.Part0 = torso; leftShoulder.Part1 = leftArm
		leftShoulder.C0 = CFrame.new(-1.5, 0.1, 0) * CFrame.Angles(0, math.rad(90), 0); leftShoulder.Parent = torso
	
		local rightShoulder = Instance.new("Motor6D")
		rightShoulder.Name = "Right Shoulder"; rightShoulder.Part0 = torso; rightShoulder.Part1 = rightArm
		rightShoulder.C0 = CFrame.new(1.5, 0.1, 0) * CFrame.Angles(0, math.rad(-90), 0); rightShoulder.Parent = torso
	
		local leftHip = Instance.new("Motor6D")
		leftHip.Name = "Left Hip"; leftHip.Part0 = torso; leftHip.Part1 = leftLeg
		leftHip.C0 = CFrame.new(-0.5, -2.0, 0); leftHip.Parent = torso
	
		local rightHip = Instance.new("Motor6D")
		rightHip.Name = "Right Hip"; rightHip.Part0 = torso; rightHip.Part1 = rightLeg
		rightHip.C0 = CFrame.new(0.5, -2.0, 0); rightHip.Parent = torso
	end
	
	-- 🚀 СУПЕР БЫСТРОЕ СЛЕДОВАНИЕ!
	local function startFollowing()
		if follower then follower:Destroy() end
	
		createFollower()
	
		task.wait(0.05)  -- СВЕРХБЫСТРО!
		activateDecals()
	
		-- ⚡ МАКСИМАЛЬНАЯ СКОРОСТЬ!
		followConnection = RunService.Heartbeat:Connect(function()
			local character = player.Character
			if not character or not character:FindFirstChild("HumanoidRootPart") or not follower or not follower.PrimaryPart then return end
	
			local myRoot = character.HumanoidRootPart
			local offset = (myRoot.CFrame.RightVector * 3.5) + (myRoot.CFrame.LookVector * -1) + Vector3.new(0, 2, 0)
			local targetPos = myRoot.Position + offset
	
			local currentPos = follower.PrimaryPart.Position
			local distance = (targetPos - currentPos).Magnitude
	
			-- 🚀 МАКС СКОРОСТЬ 150 + ТЕЛЕПОРТ!
			if distance > 1.5 then
				local direction = (targetPos - currentPos).Unit
	
				-- СВЕРХБЫСТРАЯ СКОРОСТЬ!
				follower.PrimaryPart.Velocity = direction * 150
				follower.PrimaryPart.AssemblyLinearVelocity = direction * 150
	
				-- 🧲 ТЕЛЕПОРТ если ОЧЕНЬ далеко!
				if distance > 50 then
					follower:SetPrimaryPartCFrame(CFrame.new(targetPos))
					print("🧲 ТЕЛЕПОРТ!")
				end
	
			else
				-- СТОИТ РЯДОМ
				follower.PrimaryPart.Velocity = Vector3.new(0, 0, 0)
				follower.PrimaryPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end
	
			-- МГНОВЕННЫЙ ПОВОРОТ
			local lookDirection = (myRoot.Position - follower.PrimaryPart.Position).Unit
			follower:SetPrimaryPartCFrame(CFrame.lookAt(follower.PrimaryPart.Position, follower.PrimaryPart.Position + lookDirection))
		end)
	
		print("🚀 СУПЕР БЫСТРЫЙ РИГ! 150+ ТЕЛЕПОРТ!")
	end
	
	-- ⚡ МГНОВЕННЫЙ СТАРТ ПО РЕСЕТУ
	player.CharacterAdded:Connect(function()
		task.wait(0.05)  -- СВЕРХБЫСТРО!
		startFollowing()
	end)
	
	if player.Character then
		task.wait(0.05)
		startFollowing()
	end
	
	print("💨 МАКСИМАЛЬНАЯ СКОРОСТЬ | НИКОГДА НЕ ОТСТАЁТ!")
	
end
