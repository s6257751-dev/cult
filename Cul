local function GFJR_fake_script() -- Frame.LocalScript 
	local script = Instance.new('LocalScript', Frame)

	local UIS = game:GetService('UserInputService')
	
	local frame = script.Parent
	
	
	local dragToggle = nil
	
	local dragSpeed = 0.25
	
	local dragStart = nil
	
	local startPos = nil
	
	
	
	local function updateInput(input)
	
		local delta = input.Position - dragStart
	
		local position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
	
			startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	
		game:GetService('TweenService'):Create(frame, TweenInfo.new(dragSpeed), {Position = position}):Play()
	
	end
	
	
	
	frame.InputBegan:Connect(function(input)
	
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then 
	
			dragToggle = true
	
			dragStart = input.Position
	
			startPos = frame.Position
	
			input.Changed:Connect(function()
	
				if input.UserInputState == Enum.UserInputState.End then
	
					dragToggle = false
	
				end
	
			end)
	
		end
	
	end)
	
	
	
	UIS.InputChanged:Connect(function(input)
	
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
	
			if dragToggle then
	
				updateInput(input)
	
			end
	
		end
	
	end)
	
	
end
coroutine.wrap(GFJR_fake_script)()
local function DTJFKA_fake_script() -- TextButton1.LocalScript 
	local script = Instance.new('LocalScript', TextButton1)

	local button = script.Parent
	local superSpeed = 2500
	local normalSpeed = 16 -- стандартная скорость по умолчанию
	local isSpeedActive = false -- состояние включения скорости
	
	local function toggleSpeed()
		local player = game.Players.LocalPlayer
		if not player.Character then return end
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
	
		if not isSpeedActive then
			-- Включаем суперскорость
			humanoid.WalkSpeed = superSpeed
			isSpeedActive = true
		else
			-- Выключаем и возвращаем стандартную скорость
			humanoid.WalkSpeed = normalSpeed
			isSpeedActive = false
		end
	end
	
	button.MouseButton1Click:Connect(toggleSpeed)
	
	-- Обработчик, если персонаж умирает и возрождается
	local player = game.Players.LocalPlayer
	local function onCharacterAdded(character)
		local humanoid = character:WaitForChild("Humanoid")
		-- При возрождении сбрасываем скорость и состояние
		humanoid.WalkSpeed = normalSpeed
		isSpeedActive = false
	end
	
	player.CharacterAdded:Connect(onCharacterAdded)
	-- Если персонаж уже есть при запуске
	if player.Character then
		onCharacterAdded(player.Character)
	end
end
